[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui_manager.gd" id="1_ui"]

[sub_resource type="StyleBoxFlat" id="style_normal"]
bg_color = Color(0.2, 0.6, 1, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.8, 0.8, 0.8, 1)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8

[sub_resource type="StyleBoxFlat" id="style_hover"]
bg_color = Color(0.3, 0.7, 1, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(1, 1, 1, 1)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8

[sub_resource type="StyleBoxFlat" id="style_pressed"]
bg_color = Color(0.1, 0.5, 0.8, 1)
border_width_left = 3
border_width_top = 3
border_width_right = 3
border_width_bottom = 3
border_color = Color(1, 0.84, 0.25, 1)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8

[node name="UI" type="CanvasLayer" groups=["ui"]]
script = ExtResource("1_ui")

[node name="MarginContainer" type="MarginContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 20

[node name="VBoxContainer" type="VBoxContainer" parent="MarginContainer"]
theme_override_constants/separation = 10

[node name="HBoxContainer_Score" type="HBoxContainer" parent="MarginContainer/VBoxContainer"]

[node name="ScoreLabel" type="Label" parent="MarginContainer/VBoxContainer/HBoxContainer_Score"]
text = "Score: 0"

[node name="HBoxContainer_Lives" type="HBoxContainer" parent="MarginContainer/VBoxContainer"]

[node name="LivesLabel" type="Label" parent="MarginContainer/VBoxContainer/HBoxContainer_Lives"]
text = "Vidas: 3"

[node name="HBoxContainer_Combo" type="HBoxContainer" parent="MarginContainer/VBoxContainer"]

[node name="ComboLabel" type="Label" parent="MarginContainer/VBoxContainer/HBoxContainer_Combo"]
text = ""

[node name="QuestionContainer" type="VBoxContainer" parent="MarginContainer/VBoxContainer"]
visible = false
theme_override_constants/separation = 8

[node name="QuestionLabel" type="Label" parent="MarginContainer/VBoxContainer/QuestionContainer"]
text = "Pergunta: ?"
horizontal_alignment = 1

[node name="TimerLabel" type="Label" parent="MarginContainer/VBoxContainer/QuestionContainer"]
text = "Tempo: 5.0s"
horizontal_alignment = 1

[node name="AlternativesContainer" type="HBoxContainer" parent="MarginContainer/VBoxContainer/QuestionContainer"]
alignment = 1
theme_override_constants/separation = 12

[node name="AltBtn1" type="Button" parent="MarginContainer/VBoxContainer/QuestionContainer/AlternativesContainer"]
custom_minimum_size = Vector2(64, 48)
toggle_mode = true
theme_override_styles/normal = SubResource("style_normal")
theme_override_styles/hover = SubResource("style_hover")
theme_override_styles/pressed = SubResource("style_pressed")
text = "1"

[node name="AltBtn2" type="Button" parent="MarginContainer/VBoxContainer/QuestionContainer/AlternativesContainer"]
custom_minimum_size = Vector2(64, 48)
toggle_mode = true
theme_override_styles/normal = SubResource("style_normal")
theme_override_styles/hover = SubResource("style_hover")
theme_override_styles/pressed = SubResource("style_pressed")
text = "2"

[node name="AltBtn3" type="Button" parent="MarginContainer/VBoxContainer/QuestionContainer/AlternativesContainer"]
custom_minimum_size = Vector2(64, 48)
toggle_mode = true
theme_override_styles/normal = SubResource("style_normal")
theme_override_styles/hover = SubResource("style_hover")
theme_override_styles/pressed = SubResource("style_pressed")
text = "3"

[node name="AltBtn4" type="Button" parent="MarginContainer/VBoxContainer/QuestionContainer/AlternativesContainer"]
custom_minimum_size = Vector2(64, 48)
toggle_mode = true
theme_override_styles/normal = SubResource("style_normal")
theme_override_styles/hover = SubResource("style_hover")
theme_override_styles/pressed = SubResource("style_pressed")
text = "4"

[node name="FeedbackFlash" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(1, 1, 1, 0)
